# Copy to .env.local for local development. Never commit real values.
# Separate keys per environment (local, staging, production); rotate on staff change.

# --- App ---
APP_ENV=local                         # local | staging | production
NEXT_PUBLIC_APP_URL=http://localhost:3000
INTEGRATIONS_MODE=fake                # fake | live — fake wires every vendor to an in-memory fake
PHONE_HASH_SALT=change-me             # HMAC salt for phone hashes in logs and wa_messages
CRON_SECRET=change-me                 # shared secret for /api/jobs/*; also stored in private.job_config with app_url
NEXT_PUBLIC_DEFAULT_COUNTRY=NG        # reads phone numbers typed without +country before a user has an org

# --- Supabase (one project per environment; see BUILD_SPEC §12 data residency) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server only, never in client code
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATA_REGION=af                        # region this deployment stores data in
SEND_SMS_HOOK_SECRET=                 # Supabase Auth send-SMS hook secret (v1,whsec_...); local value in supabase/config.toml

# --- Payments (§11) ---
PAYSTACK_SECRET_KEY=                  # also signs webhooks (x-paystack-signature, HMAC-SHA512)
PAYSTACK_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_HASH=             # verif-hash header
STRIPE_SECRET_KEY=                    # Phase 4
STRIPE_WEBHOOK_SECRET=                # Phase 4

# --- Messaging ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=                  # verifies X-Hub-Signature-256
WHATSAPP_VERIFY_TOKEN=                # webhook verification handshake
WHATSAPP_API_VERSION=v23.0           # Graph API version
TERMII_API_KEY=
TERMII_SENDER_ID=                     # approved alphanumeric sender ID, e.g. Tideline
TERMII_BASE_URL=https://api.ng.termii.com   # your account's base URL (Termii dashboard)
SMS_WEBHOOK_TOKEN=                    # random; also put in the inbound SMS URL as ?token=

# --- AI (launch choice: Claude for AI and OCR, OpenAI Whisper for voice notes) ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5           # one model for every AI job
LLM_FALLBACKS=on                      # server-side refusal fallback (Claude API)
OPENAI_API_KEY=                       # speech-to-text only
STT_MODEL=whisper-1
AI_MONTHLY_JOB_LIMIT=500              # per-org AI calls per month until plans set budgets (M7)
AI_COST_PER_1K_TOKENS_MINOR=0         # cost estimate written to ai_jobs

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=                           # e.g. Tideline <no-reply@mail.yourdomain.com>, domain verified in Resend

# --- Payments mode: live uses the keys above (test keys on staging) ---
PAYMENTS_MODE=fake                    # fake | live
ESCROW_ENABLED=off                    # on only after legal sign-off

# --- Hosting disclosure shown on /privacy ---
NEXT_PUBLIC_DATA_HOSTING="Supabase, eu-west-2 (London, UK)"

# --- Weather ---
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_MARINE_URL=https://marine-api.open-meteo.com/v1/marine
WEATHER_PROVIDER=open-meteo           # fake locally if you want offline dev

# --- Maps ---
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- Monitoring and analytics ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# --- Feature flags ---
# Charter, escrow and Phase 3 are switched in Admin → Feature flags (database), not here.
# Escrow in production also needs ESCROW_ENABLED=on above.
