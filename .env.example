# Copy to .env.local for local development. Never commit real values.
# Separate keys per environment (local, staging, production); rotate on staff change.

# --- App ---
APP_ENV=local                         # local | staging | production
NEXT_PUBLIC_APP_URL=http://localhost:3000
INTEGRATIONS_MODE=fake                # fake | live — fake wires every vendor to an in-memory fake
PHONE_HASH_SALT=change-me             # HMAC salt for phone hashes in logs and wa_messages
CRON_SECRET=change-me                 # shared secret for scheduled job endpoints

# --- Supabase (one project per environment; see BUILD_SPEC §12 data residency) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server only, never in client code
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATA_REGION=af                        # region this deployment stores data in
SEND_SMS_HOOK_SECRET=                 # Supabase Auth send-SMS hook secret (v1,whsec_...); local value in supabase/config.toml

# --- Payments (§11) ---
PAYSTACK_SECRET_KEY=                  # also signs webhooks (x-paystack-signature, HMAC-SHA512)
PAYSTACK_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_HASH=             # verif-hash header
STRIPE_SECRET_KEY=                    # Phase 4
STRIPE_WEBHOOK_SECRET=                # Phase 4

# --- Messaging ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=                  # verifies X-Hub-Signature-256
WHATSAPP_VERIFY_TOKEN=                # webhook verification handshake
TERMII_API_KEY=
TERMII_SENDER_ID=
TERMII_BASE_URL=https://api.ng.termii.com

# --- AI (vendors chosen after accuracy tests; Appendix item 7) ---
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
STT_PROVIDER=
STT_API_KEY=
OCR_PROVIDER=
OCR_API_KEY=

# --- Weather ---
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_MARINE_URL=https://marine-api.open-meteo.com/v1/marine

# --- Maps ---
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- Monitoring and analytics ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# --- Feature flags (§14) ---
FEATURE_CHARTER=false
FEATURE_ESCROW=false                  # stays off in production until legal sign-off
FEATURE_PHASE3=false
